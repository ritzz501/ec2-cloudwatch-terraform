aws_region    = "ap-south-1"
project_name  = "ec2-cw-state-monitor"
instance_type = "t3.micro"
key_name      = "YOUR_EXISTING_KEY_PAIR_NAME"
ssh_cidr      = "YOUR_PUBLIC_IP/32"
cpu_threshold = 70
# Optional: enter your email to receive SNS notifications. Confirm the subscription email.
alert_email   = ""
